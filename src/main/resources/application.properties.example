spring.application.name=backend
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/Lumina}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:2741}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Limites para Upload de Arquivos (Protecao contra DoS)
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# =============================================================================
# Configuracoes JWT
# =============================================================================
# Tempo de validade do token em SEGUNDOS (3600 = 1 hora)
jwt.validity=${JWT_VALIDITY:3600}
jwt.secret=${JWT_SECRET:minha-chave-secreta-padrao-desenvolvimento}
jwt.cookie.secure=${JWT_COOKIE_SECURE:false}

# =============================================================================
# Integracao Google Gemini AI
# =============================================================================
gemini.api.key=${GEMINI_API_KEY:test-gemini-key}

# =============================================================================
# Configuracoes AWS
# =============================================================================
aws.access-key=${AWS_ACCESS_KEY:test-key}
aws.secret-key=${AWS_SECRET_KEY:test-secret}
aws.region=${AWS_REGION:us-east-1}

# =============================================================================
# Actuator e Logs
# =============================================================================
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=never
logging.level.com.lumina=${LOG_LEVEL:INFO}

# =============================================================================
# Configuracoes Alexa Reminders & LWA (Login with Amazon)
# =============================================================================
alexa.lwa.client-id=${ALEXA_LWA_CLIENT_ID:}
alexa.lwa.client-secret=${ALEXA_LWA_CLIENT_SECRET:}
alexa.reminders.enabled=${ALEXA_REMINDERS_ENABLED:true}
