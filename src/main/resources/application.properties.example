spring.application.name=backend
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/Lumina}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:lumina_dev_pass_8492}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Limites para Upload de Arquivos (Protecao contra DoS)
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# =============================================================================
# Configuracoes JWT
# =============================================================================
# Tempo de validade do token em SEGUNDOS (3600 = 1 hora)
jwt.validity=${JWT_VALIDITY:3600}
jwt.secret=${JWT_SECRET:minha-chave-secreta-padrao-desenvolvimento}
jwt.cookie.secure=${JWT_COOKIE_SECURE:false}

# =============================================================================
# Integracao Google Gemini AI
# =============================================================================
gemini.api.key=${GEMINI_API_KEY:test-gemini-key}

# =============================================================================
# Configuracoes AWS
# =============================================================================
aws.access-key=${AWS_ACCESS_KEY:test-key}
aws.secret-key=${AWS_SECRET_KEY:test-secret}
aws.region=${AWS_REGION:us-east-1}
aws.s3.bucket-name=${AWS_S3_BUCKET_NAME:lumina-storage}


# =============================================================================
# Actuator e Logs
# =============================================================================
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=never
logging.level.com.lumina=${LOG_LEVEL:INFO}

# =============================================================================
# Configuracoes Alexa Reminders & LWA (Login with Amazon)
# =============================================================================
alexa.lwa.client-id=${ALEXA_LWA_CLIENT_ID:}
alexa.lwa.client-secret=${ALEXA_LWA_CLIENT_SECRET:}
alexa.reminders.enabled=${ALEXA_REMINDERS_ENABLED:true}

# =============================================================================
# Configuração RabbitMQ e Notificações WhatsApp (D-1)
# =============================================================================
app.public-url=${APP_PUBLIC_URL:http://localhost:5173}
spring.rabbitmq.host=${SPRING_RABBITMQ_HOST:localhost}
spring.rabbitmq.port=${SPRING_RABBITMQ_PORT:5672}
spring.rabbitmq.username=${SPRING_RABBITMQ_USERNAME:guest}
spring.rabbitmq.password=${SPRING_RABBITMQ_PASSWORD:guest}
spring.rabbitmq.listener.simple.default-requeue-rejected=false
spring.rabbitmq.listener.simple.retry.enabled=true
spring.rabbitmq.listener.simple.retry.max-attempts=3
spring.rabbitmq.listener.simple.retry.initial-interval=1000ms
spring.rabbitmq.listener.simple.retry.multiplier=2.0

# =============================================================================
# Agenda de consultas
# =============================================================================
lumina.agenda.fuso-horario=${AGENDA_FUSO_HORARIO:America/Sao_Paulo}
lumina.agenda.inicio-jornada=${AGENDA_INICIO_JORNADA:08:00}
lumina.agenda.fim-jornada=${AGENDA_FIM_JORNADA:18:00}
