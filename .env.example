# =============================================================================
# Banco de Dados (MySQL)
# =============================================================================
DB_URL=jdbc:mysql://localhost:3306/Lumina
DB_USERNAME=root
DB_PASSWORD=sua_senha_mysql_aqui
MYSQL_DATABASE=Lumina
MYSQL_ROOT_PASSWORD=sua_senha_mysql_aqui
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/Lumina?createDatabaseIfNotExist=true&useSSL=false

# =============================================================================
# Autenticação e Segurança (JWT)
# =============================================================================
# Chave HMAC-SHA256 codificada em Base64 (mínimo de 256 bits / 32 bytes)
JWT_
JWT_VALIDITY=3600
JWT_COOKIE_SECURE=false

# =============================================================================
# Integrações Externas (Gemini AI & AWS)
# =============================================================================
GEMINI_API_KEY=sua_chave_gemini_aqui
AWS_ACCESS_KEY=sua_aws_access_key
AWS_SECRET_KEY=sua_aws_secret_key
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
AWS_SESSION_TOKEN=seu_session_token_aqui_se_houver
AWS_REGION=us-east-1

# Buckets S3 (Camadas da Arquitetura Medalhão & Logs)
BUCKET_BRONZE=lumina-sptech-bronze
BUCKET_SILVER=lumina-sptech-silver
BUCKET_GOLD=lumina-sptech-gold
BUCKET_ATHENA_RESULTS=lumina-sptech-athena-results
AWS_S3_BUCKET_NAME=lumina-sptech-storage

# Ambiente
ENVIRONMENT=dev

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
