# ==============================================================================
# Variáveis de Ambiente - Lumina Logging & Telemetria
# ==============================================================================

# Credenciais da AWS (Para uso local ou AWS Academy Session Token)
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
AWS_SESSION_TOKEN=seu_session_token_aqui_se_houver
AWS_REGION=us-east-1

# Buckets S3 (Camadas da Arquitetura Medalhão)
BUCKET_BRONZE=lumina-bronze
BUCKET_SILVER=lumina-silver
BUCKET_GOLD=lumina-gold
BUCKET_ATHENA_RESULTS=lumina-athena-results

# Ambiente
ENVIRONMENT=dev

# Configurações do Banco de Dados MySQL
DB_USERNAME=root
DB_PASSWORD=mafalu09
MYSQL_DATABASE=Lumina
MYSQL_ROOT_PASSWORD=mafalu09
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/Lumina?createDatabaseIfNotExist=true&useSSL=false
